{
  "name": "@bistrysklad/sdk",
  "version": "0.1.0-beta.4",
  "description": "Typed client and company schema generator for Bistry Sklad",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "bin": {
    "bistrysklad": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && tsc -p test/tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bistrysklad/sdk.git"
  },
  "homepage": "https://github.com/bistrysklad/sdk#readme",
  "bugs": {
    "url": "https://github.com/bistrysklad/sdk/issues"
  }
}
